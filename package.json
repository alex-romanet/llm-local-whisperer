{
  "name": "llm-local-whisperer",
  "version": "1.0.0",
  "description": "Voice-to-chat CLI for local LLMs using Whisper STT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "llm-local-whisperer": "dist/index.js"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "tsc && node dist/index.js",
    "config": "tsc && node dist/index.js --config",
    "whisper:start": "bash scripts/whisper-start.sh",
    "whisper:stop": "bash scripts/whisper-stop.sh",
    "whisper:logs": "docker logs -f llm-whisper",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "echo 'No tests yet' && exit 0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.0.0",
    "openai": "^4.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "Alexandru Romanet",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-romanet/llm-local-whisperer"
  },
  "keywords": ["voice", "llm", "whisper", "cli", "ollama", "stt", "local-ai"]
}
